# ローカル開発用シークレット。このファイルを .dev.vars にコピーして値を入れてください。
# 本番は `wrangler secret put <NAME>` を使います。.dev.vars はコミットしないでください。
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Cloudflare Workers AI（デプロイ時はバインディングで無料・キー不要）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OWNER_TOKEN=

# --- avatar image generation (optional) --------------------------------------
# Workers AI is keyless once deployed on Cloudflare. Off-platform, set a scoped
# token + account id to reach the same model over REST. GEMINI_API_KEY (above)
# enables the Gemini image engine as the second choice. With no key at all the
# local engine still draws a deterministic avatar from the instruction text —
# no AI, no network, labelled as such in the UI.
# IMAGE_MODEL_WORKERSAI=@cf/black-forest-labs/flux-1-schnell
# IMAGE_MODEL_GEMINI=gemini-nano-banana-2.1

# --- Cloud PC (remote runner) -------------------------------------------------
# Heavy work is handed to a machine with a real filesystem. Off by default.
#   RUNNER_ENABLED=true
#   RUNNER_TOKEN=<a long random string>       # the machine pairs with this
#   RUNNER_ALLOW=node,npm,python3,git,ls,cat,curl
#   RUNNER_MAX_MS=60000
#   RUNNER_MAX_OUTPUT=20000
# On the cloud PC:
#   RUNNER_URL=https://<your-url> RUNNER_TOKEN=<same> bash runner/cloud-pc.sh
