{
  "name": "wealth-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Autonomous Wealth Agent — a self-directed income research & execution agent (PWA + Cloudflare Workers + D1)",
  "scripts": {
    "dev": "node server/local.mjs",
    "test": "node tests/run.mjs && node tests/capabilities.mjs",
    "test:ea": "node tests/ea.test.mjs",
    "test:scout": "node tests/scout.test.mjs",
    "test:cdp": "node tests/cdp-facilitator.test.mjs",
    "test:fxlab": "node tests/fxlab.test.mjs",
    "test:grammar": "node tests/grammar.test.mjs",
    "test:robust": "node tests/robust.test.mjs",
    "test:social": "node tests/social.test.mjs",
    "report:ea": "node scripts/ea-report.mjs",
    "test:unit": "node tests/unit.test.mjs",
    "deploy:worker": "wrangler deploy",
    "deploy:db": "wrangler d1 execute wealth-agent --file=./schema.sql --remote",
    "db:local": "wrangler d1 execute wealth-agent --file=./schema.sql --local",
    "test:fleet": "node tests/fleet.test.mjs",
    "test:runner": "node tests/runner.test.mjs",
    "test:all": "node tests/unit.test.mjs && node tests/run.mjs && node tests/avatar.test.mjs && node tests/fleet.test.mjs && node tests/runner.test.mjs",
    "runner": "node runner/agent-runner.mjs",
    "deploy": "bash scripts/deploy-cloudflare.sh",
    "test:jobs": "node tests/jobs.test.mjs",
    "test:pairing": "node --test tests/pairing.test.mjs",
    "test:loop": "node tests/loop.test.mjs",
    "test:free": "node tests/freemium.test.mjs",
    "test:risk": "node tests/risk.test.mjs",
    "test:prop": "node tests/prop.test.mjs",
    "test:e8": "node tests/e8.test.mjs",
    "test:opt": "node tests/opt.test.mjs",
    "test:lab": "node tests/lab.test.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  }
}
